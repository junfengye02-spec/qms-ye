# Copy to .env and fill in deployment-specific values. Never commit .env.
INVENTREE_IMAGE=wmsye-inventree:dev
INVENTREE_EXT_VOLUME=./inventree-data

# Mandatory: choose a strong non-empty password before running Compose.
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432
INVENTREE_DB_NAME=inventree
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=

INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379
INVENTREE_CACHE_DB=0

INVENTREE_WEB_PORT=8000
INVENTREE_HTTP_PORT=8088
INVENTREE_HTTPS_PORT=443
# Replace localhost with a reachable hostname or LAN IP for other devices.
INVENTREE_SITE_HOST=localhost
INVENTREE_SITE_URL=https://localhost
INVENTREE_TIMEZONE=Asia/Shanghai
INVENTREE_DEBUG=False
INVENTREE_LOG_LEVEL=WARNING

# Optional notifications; use a dedicated test group during validation.
INVENTREE_WECOM_BOT_WEBHOOK_URL=
INVENTREE_WECOM_BOT_MENTION_USER_IDS=

# Optional Windows local printing, disabled until hardware acceptance.
INVENTREE_LOCAL_PRINT_ENABLED=False
INVENTREE_LOCAL_PRINT_QZ_VERSION=2.2.5
INVENTREE_LOCAL_PRINT_DOWNLOAD_URL=
# Required only for docker-compose.local-print.yml; absolute host file paths.
WMS_LOCAL_PRINT_CERTIFICATE_FILE=
WMS_LOCAL_PRINT_PRIVATE_KEY_FILE=
