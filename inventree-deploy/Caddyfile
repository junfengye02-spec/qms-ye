{
	default_sni {$INVENTREE_SITE_HOST}
}

(log_common) {
	log {
		output file /var/log/caddy/{args[0]}.access.log
	}
}

(cors-headers) {
	header Allow GET,HEAD,OPTIONS
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Methods GET,HEAD,OPTIONS
	header Access-Control-Allow-Headers Authorization,Content-Type,User-Agent,traceparent

	@cors_preflight{args[0]} method OPTIONS
	handle @cors_preflight{args[0]} {
		respond "" 204
	}
}

(inventree-app) {
	encode gzip

	request_body {
		max_size 100MB
	}

	handle_path /static/* {
		import cors-headers static
		root * /var/www/static
		file_server
	}

	handle_path /media/* {
		import cors-headers media
		root * /var/www/media
		file_server
		header Content-Disposition attachment
		forward_auth {$INVENTREE_SERVER:"http://inventree-server:8000"} {
			uri /auth/
		}
	}

	reverse_proxy {$INVENTREE_SERVER:"http://inventree-server:8000"}
}

:80 {
	import log_common inventree-http
	redir https://{$INVENTREE_SITE_HOST}{uri} permanent
}

https://{$INVENTREE_SITE_HOST} {
	import log_common inventree-https
	tls internal
	import inventree-app
}
